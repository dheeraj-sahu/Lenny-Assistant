# =============================================================
# Lenny Growth Assistant — .gitignore
# =============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/
.eggs/
pip-wheel-metadata/

# ── Environment / Secrets ─────────────────────────────────────
# NEVER commit .env — it contains your DB password and API keys
backend/.env
.env
.env.local
.env.*.local
*.env

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite3

# ── Testing ───────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────────────────
*.log

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── Data (large, auto-generated) ──────────────────────────────
# Transcript repo cloned locally during development
backend/data/
data/

# sentence-transformers model cache
.cache/
backend/.cache/

# ── Assignment source docs (large PDFs — keep .txt versions) ──
*.pdf

# ── Temp / scratch files ───────────────────────────────────────
*.tmp
*.bak
tmp/
scratch/

# ── Egg-info generated by pip install -e ──────────────────────
backend/*.egg-info/
lenny_growth_assistant_backend.egg-info/
