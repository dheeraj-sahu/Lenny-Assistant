# ─────────────────────────────────────────────────────────
#  The Lenny Growth Assistant — Environment Variables
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────
# "ollama" (default, free, local) | "anthropic" (cloud, paid)
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic Cloud settings (used when LLM_PROVIDER=anthropic)
# Leave blank if using Ollama — will be ignored
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Database ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lenny_assistant
POSTGRES_USER=lenny
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://lenny:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/lenny_assistant

# ── Qdrant Vector DB ──────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=lenny_transcripts

# ── Embedding Model ───────────────────────────────────────
# sentence-transformers model name (runs locally, no API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Ingestion ─────────────────────────────────────────────
TRANSCRIPTS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
TRANSCRIPTS_LOCAL_PATH=/app/data/transcripts

# ── Application ───────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ──────────────────────────────────────────────
# Secret for internal admin endpoints (e.g. /admin/refresh-kb)
ADMIN_SECRET=REPLACE_WITH_RANDOM_SECRET
